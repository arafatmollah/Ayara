[[["وَٱلضُّحَىٰ","wal-ḍuḥā","By the morning brightness"]],[["وَٱلَّيْلِ","wa-al-layli","And the night"],["إِذَا","idhā","when"],["سَجَىٰ","sajā","it covers with darkness"]],[["مَا","mā","Not"],["وَدَّعَكَ","waddaʿaka","has forsaken you"],["رَبُّكَ","rabbuka","your Lord"],["وَمَا","wamā","and not"],["قَلَىٰ","qalā","He is displeased"]],[["وَلَلْـَٔاخِرَةُ","walalākhiratu","And surely the Hereafter"],["خَيْرٌۭ","khayrun","(is) better"],["لَّكَ","laka","for you"],["مِنَ","mina","than"],["ٱلْأُولَىٰ","l-ūlā","the first"]],[["وَلَسَوْفَ","walasawfa","And soon"],["يُعْطِيكَ","yuʿ'ṭīka","will give you"],["رَبُّكَ","rabbuka","your Lord"],["فَتَرْضَىٰٓ","fatarḍā","then you will be satisfied"]],[["أَلَمْ","alam","Did not"],["يَجِدْكَ","yajid'ka","He find you"],["يَتِيمًۭا","yatīman","an orphan"],["فَـَٔاوَىٰ","faāwā","and give shelter"]],[["وَوَجَدَكَ","wawajadaka","And He found you"],["ضَآلًّۭا","ḍāllan","lost"],["فَهَدَىٰ","fahadā","so He guided"]],[["وَوَجَدَكَ","wawajadaka","And He found you"],["عَآئِلًۭا","ʿāilan","in need"],["فَأَغْنَىٰ","fa-aghnā","so He made self-sufficient"]],[["فَأَمَّا","fa-ammā","So as for"],["ٱلْيَتِيمَ","l-yatīma","the orphan"],["فَلَا","falā","then (do) not"],["تَقْهَرْ","taqhar","oppress"]],[["وَأَمَّا","wa-ammā","And as for"],["ٱلسَّآئِلَ","l-sāila","one who asks"],["فَلَا","falā","then (do) not"],["تَنْهَرْ","tanhar","repel"]],[["وَأَمَّا","wa-ammā","But as for"],["بِنِعْمَةِ","biniʿ'mati","(the) Favor"],["رَبِّكَ","rabbika","(of) your Lord"],["فَحَدِّثْ","faḥaddith","narrate"]]]