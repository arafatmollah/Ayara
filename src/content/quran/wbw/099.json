[[["إِذَا","idhā","When"],["زُلْزِلَتِ","zul'zilati","is shaken"],["ٱلْأَرْضُ","l-arḍu","the earth"],["زِلْزَالَهَا","zil'zālahā","(with) its earthquake"]],[["وَأَخْرَجَتِ","wa-akhrajati","And brings forth"],["ٱلْأَرْضُ","l-arḍu","the earth"],["أَثْقَالَهَا","athqālahā","its burdens"]],[["وَقَالَ","waqāla","And says"],["ٱلْإِنسَـٰنُ","l-insānu","man"],["مَا","mā","What"],["لَهَا","lahā","(is) with it"]],[["يَوْمَئِذٍۢ","yawma-idhin","That Day"],["تُحَدِّثُ","tuḥaddithu","it will report"],["أَخْبَارَهَا","akhbārahā","its news"]],[["بِأَنَّ","bi-anna","Because"],["رَبَّكَ","rabbaka","your Lord"],["أَوْحَىٰ","awḥā","inspired"],["لَهَا","lahā","[to] it"]],[["يَوْمَئِذٍۢ","yawma-idhin","That Day"],["يَصْدُرُ","yaṣduru","will proceed"],["ٱلنَّاسُ","l-nāsu","the mankind"],["أَشْتَاتًۭا","ashtātan","(in) scattered groups"],["لِّيُرَوْا۟","liyuraw","to be shown"],["أَعْمَـٰلَهُمْ","aʿmālahum","their deeds"]],[["فَمَن","faman","So whoever"],["يَعْمَلْ","yaʿmal","does"],["مِثْقَالَ","mith'qāla","(equal to the) weight"],["ذَرَّةٍ","dharratin","(of) an atom"],["خَيْرًۭا","khayran","good"],["يَرَهُۥ","yarahu","will see it"]],[["وَمَن","waman","And whoever"],["يَعْمَلْ","yaʿmal","does"],["مِثْقَالَ","mith'qāla","(equal to the) weight"],["ذَرَّةٍۢ","dharratin","(of) an atom"],["شَرًّۭا","sharran","evil"],["يَرَهُۥ","yarahu","will see it"]]]