[[["إِنَّآ","innā","Indeed, We"],["أَعْطَيْنَـٰكَ","aʿṭaynāka","We have given you"],["ٱلْكَوْثَرَ","l-kawthara","Al-Kauthar"]],[["فَصَلِّ","faṣalli","So pray"],["لِرَبِّكَ","lirabbika","to your Lord"],["وَٱنْحَرْ","wa-in'ḥar","and sacrifice"]],[["إِنَّ","inna","Indeed"],["شَانِئَكَ","shāni-aka","your enemy "],["هُوَ","huwa","he (is)"],["ٱلْأَبْتَرُ","l-abtaru","the one cut off"]]]