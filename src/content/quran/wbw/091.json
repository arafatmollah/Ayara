[[["وَٱلشَّمْسِ","wal-shamsi","By the sun"],["وَضُحَىٰهَا","waḍuḥāhā","and its brightness"]],[["وَٱلْقَمَرِ","wal-qamari","And the moon"],["إِذَا","idhā","when"],["تَلَىٰهَا","talāhā","it follows it"]],[["وَٱلنَّهَارِ","wal-nahāri","And the day"],["إِذَا","idhā","when"],["جَلَّىٰهَا","jallāhā","it displays it"]],[["وَٱلَّيْلِ","wa-al-layli","And the night"],["إِذَا","idhā","when"],["يَغْشَىٰهَا","yaghshāhā","it covers it"]],[["وَٱلسَّمَآءِ","wal-samāi","And the heaven"],["وَمَا","wamā","and (He) Who"],["بَنَىٰهَا","banāhā","constructed it"]],[["وَٱلْأَرْضِ","wal-arḍi","And the earth"],["وَمَا","wamā","and by (He) Who"],["طَحَىٰهَا","ṭaḥāhā","spread it"]],[["وَنَفْسٍۢ","wanafsin","And (the) soul"],["وَمَا","wamā","and (He) Who"],["سَوَّىٰهَا","sawwāhā","proportioned it"]],[["فَأَلْهَمَهَا","fa-alhamahā","And He inspired it"],["فُجُورَهَا","fujūrahā","(to distinguish) its wickedness"],["وَتَقْوَىٰهَا","wataqwāhā","and its righteousness"]],[["قَدْ","qad","Indeed"],["أَفْلَحَ","aflaḥa","he succeeds"],["مَن","man","who"],["زَكَّىٰهَا","zakkāhā","purifies it"]],[["وَقَدْ","waqad","And indeed"],["خَابَ","khāba","he fails"],["مَن","man","who"],["دَسَّىٰهَا","dassāhā","buries it"]],[["كَذَّبَتْ","kadhabat","Denied"],["ثَمُودُ","thamūdu","Thamud"],["بِطَغْوَىٰهَآ","biṭaghwāhā","by their transgression"]],[["إِذِ","idhi","When"],["ٱنۢبَعَثَ","inbaʿatha","(was) sent forth"],["أَشْقَىٰهَا","ashqāhā","(the) most wicked of them"]],[["فَقَالَ","faqāla","But said"],["لَهُمْ","lahum","to them"],["رَسُولُ","rasūlu","(the) Messenger"],["ٱللَّهِ","l-lahi","(of) Allah"],["نَاقَةَ","nāqata","(It is the) she-camel"],["ٱللَّهِ","l-lahi","(of) Allah"],["وَسُقْيَـٰهَا","wasuq'yāhā","and her drink"]],[["فَكَذَّبُوهُ","fakadhabūhu","But they denied him"],["فَعَقَرُوهَا","faʿaqarūhā","and they hamstrung her"],["فَدَمْدَمَ","fadamdama","So destroyed"],["عَلَيْهِمْ","ʿalayhim","them"],["رَبُّهُم","rabbuhum","their Lord"],["بِذَنۢبِهِمْ","bidhanbihim","for their sin"],["فَسَوَّىٰهَا","fasawwāhā","and leveled them"]],[["وَلَا","walā","And not"],["يَخَافُ","yakhāfu","He fears"],["عُقْبَـٰهَا","ʿuq'bāhā","its consequences"]]]